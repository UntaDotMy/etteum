# ── Grok Standalone Farmer ──────────────────────────────────────────────────
# Copy to .env and edit:  cp .env.example .env

# IMAP inbox that receives OTP (Gmail App Password recommended)
GROK_IMAP_USER=you@gmail.com
GROK_IMAP_PASS=xxxx xxxx xxxx xxxx
GROK_IMAP_HOST=imap.gmail.com
GROK_IMAP_PORT=993

# Email mode: domain | plus_trick
# domain     = random@catch-all (needs working catch-all → IMAP)
# plus_trick = you+random@gmail.com (OTP lands in same Gmail)
GROK_EMAIL_MODE=domain

# Catch-all domain (domain mode) — without leading @
GROK_EMAIL_DOMAIN=koemail.my.id

# Gmail base for plus_trick (optional; defaults to GROK_IMAP_USER)
# GROK_GMAIL_BASE=you@gmail.com

# Account password for all farmed xAI accounts
GROK_PASSWORD=@YourAccountGrokPass

# How many accounts to create this run
GROK_MAX_ACCOUNTS=5
GROK_CONCURRENT=1

# false = headed browser (best for debugging Turnstile)
# true  = invisible; Camoufox prefers virtual display when available
GROK_HEADLESS=false
# How invisible mode is realized (when GROK_HEADLESS=true):
#   auto    = Linux+Xvfb → headless="virtual" (headed paint, no window) else True
#   virtual = force Camoufox virtual display (install xvfb on Linux)
#   true    = real headless=True (more CF risk on Turnstile)
#   false   = always show window
# GROK_HEADLESS_MODE=auto
# Camoufox humanize cursor — keep true for headless/virtual (CF mouse scoring)
# GROK_HUMANIZE=true
# GROK_HUMANIZE_MAX=2.2

# ── Worker isolation (each concurrent slot is independent) ─────────────────
# true  = each worker has its own Camoufox + page + Turnstile solve;
#         browser boot is parallel (no multi-second wait on siblings);
#         farm code never uses use_global_limit=True.
# false = legacy; may serialize Turnstile if use_global_limit is forced.
GROK_WORKER_ISOLATION=true
# Seconds to stagger worker *start* only (0 = all start together).
# Does not make workers wait mid-pipeline on each other.
GROK_SPAWN_DELAY=0
# Legacy CF serialize cap (ignored for queueing when isolation=true; set high).
GROK_TURNSTILE_PARALLEL=64

# After OAuth, open grok.com (CF + login) to attach free Build chat entitlement.
# Recommended true — without it many free accounts get CLI 403 permission-denied.
GROK_ACTIVATE_WEB=true

# Default mail provider for farm mode when not asked: google | tempmail
# GROK_MAIL_MODE=google
# Temp-mail browser headless (generator.email). Signup headless is GROK_HEADLESS.
# GROK_TEMPMAIL_HEADLESS=true

# Self-heal retries (do not permanent-fail on first UI blip):
GROK_UI_RETRIES=3
GROK_UI_RETRY_BACKOFF=2
# Soft-retries on chat 403 after web activate (entitlement lag)
GROK_PROBE_RETRIES=4
GROK_PROBE_RETRY_BACKOFF=2.5
# Route CLI chat probe + OAuth token exchange through the same proxy as the browser
# (reduces VPS-IP vs residential mismatch 403s). SOCKS needs: pip install PySocks
GROK_PROBE_USE_PROXY=true
# Signup: soft page refreshes + per-refresh wait when email field missing (CF lag)
GROK_SIGNUP_PAGE_REFRESHES=5
GROK_SIGNUP_EMAIL_WAIT=15
# Turnstile default max wait (seconds) when caller does not pass max_wait
GROK_TURNSTILE_MAX_WAIT=90

# Terminal UI: hud (default on TTY) | log (classic line spam)
# GROK_UI=hud
# GROK_VERBOSE=true   # show detail lines even with HUD (also always in farm.log)

# Fail-fast timeouts (stuck/unclear states free the worker slot)
# GROK_OTP_TIMEOUT=120          # IMAP wait for code
# GROK_CONFIRM_TIMEOUT=45       # still on Verify page → fail
# GROK_COMPLETE_TIMEOUT=120     # Turnstile/complete form stuck → fail
# GROK_ACCOUNT_TIMEOUT=480      # whole account hard deadline (8 min)
# GROK_REFRESH_TIMEOUT=150      # refresh-mode per account
# GROK_REFRESH_RETRIES=5

# ── Proxies (recommended for concurrent >1 / Turnstile) ─────────────────────
# Preferred: list file (one proxy per line). See proxies.txt.example
# GROK_PROXY_FILE=./proxies.txt
# If GROK_PROXY_FILE unset and ./proxies.txt exists, it is loaded automatically.
# GROK_PROXY_SHUFFLE=false
# Optional extra inline pool (merged with file), optional #id per entry:
# GROK_PROXY_POOL=http://user:pass@host:port,socks5://user:pass@host:port#node2

# Optional vision CAPTCHA (interactive puzzles only; managed Turnstile uses click)
# GROK_CAPTCHA_PROXY_URL=https://api.openai.com/v1/chat/completions
# GROK_CAPTCHA_API_KEY=sk-...
# GROK_CAPTCHA_MODEL=gpt-4o

# Results: each run creates results/batch_<timestamp>/ automatically
# GROK_RESULTS_DIR=./results
# Global email index (dedup across all batches) — auto-maintained
# GROK_USED_EMAILS_FILE=./results/used_emails.txt
# Local-part length for domain mode (crypto secrets, default 16)
# GROK_EMAIL_LOCAL_LEN=16
# Optional fixed batch id: GROK_BATCH_ID=my_batch_01
# Legacy single-file mode (disables per-batch folders):
# GROK_RESULTS_JSON=./results/accounts.json
# GROK_RESULTS_TXT=./results/accounts.txt
# GROK_FAILED_JSON=./results/failed.json
# GROK_SCREENSHOT_DIR=./screenshots
