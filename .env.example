# Core ports
PORT=1930
DASHBOARD_PORT=1931
# Bind address. Use 0.0.0.0 so the admin dashboard / API are reachable outside
# the machine (VPS). Loopback (127.0.0.1) = local only.
# HOST=0.0.0.0
# Backend the share + dashboard processes call on the same machine (keep loopback).
# BACKEND_ORIGIN=http://127.0.0.1:1930
# Public dashboard origin(s) only needed if the browser calls the backend
# cross-origin (not required when serve-dashboard proxies /api).
# POOLPROX_CORS_ORIGINS=https://admin.example.com

# ── Friend-key status page (public board on SHARE_PORT) ─────────────────
# Public entry (status board + full client API proxy on SHARE_PORT).
# When the cloud firewall only allows 80/443, put the API here:
#   OpenAI:    base = http://YOUR_IP/v1     → /v1/chat/completions, /v1/models, …
#   Anthropic: base = http://YOUR_IP       → /v1/messages
#   Codex:     /backend-api/codex/responses
# Status UI is GET / only. Admin /api/* is NOT exposed on this port.
# Treat SHARE_PORT as trusted if the status board shows full keys.
# SHARE_PORT=80
# SHARE_PUBLIC_URL=http://YOUR_PUBLIC_IP
# Backend the share SERVER proxies to (loopback on same machine).
# BACKEND_ORIGIN=http://127.0.0.1:1930
# Shown on the status card + what friends put in their app (OpenAI-style /v1).
# SHARE_BASE_URL=http://YOUR_PUBLIC_IP/v1
# Link-only mode: hides manual key entry AND makes GET /v1/share/board (the
# all-keys listing) return 403. Per-key GET /v1/share?key=… stays reachable.
# SHARE_LOCK=0

# ── Admin-surface access (host-compromising routes) ────────────────────────
# These routes need a LOOPBACK origin or a machine-bound CLI token, on top of the
# API key / dashboard session, because a leaked key alone must not reach them:
#   /api/update/apply     git pull + rebuild + restart (remote code execution)
#   /api/backup/*         export/download/import (pack contains .env + ENCRYPTION_KEY)
#   /api/mitm/*           root-CA install, hosts-file rewrite, tool→model aliases
#   /api/settings (POST)  oidc_config and other secret-bearing settings
#   /api/sync/*           config export/import
#   /api/tunnel/enable    sidecar spawn
# Administering from ANOTHER machine therefore needs one of:
#   CLI_ADMIN_TOKEN=<long random>   present the same value as x-9r-cli-token
#   ALLOW_REMOTE_ADMIN=true         disables the origin check entirely (unsafe)
# serve-dashboard.ts stamps X-Forwarded-For with the real TCP peer, so proxying
# through DASHBOARD_PORT does NOT make a remote caller look local.
# CLI_ADMIN_TOKEN=
# ALLOW_REMOTE_ADMIN=false
# Set only when a reverse proxy you control overwrites x-real-ip/x-forwarded-for.
# TRUST_PROXY=false

# API key (clients send as Authorization: Bearer <key>)
API_KEY=pool-proxy-secret-key

# Database (SQLite)
DATABASE_PATH=./data/poolprox3.db

# Token encryption key (32 hex chars). install.sh / install.ps1 generate one for you.
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# ── Request log growth (scalability) ───────────────────────────────────────
# Detail rows in request_logs are capped; analytics use usage_summary (hourly).
# Bodies are OFF by default — full bodies were the multi-GB growth source.
# POOLPROX_MAX_REQUEST_LOGS=500
# POOLPROX_LOG_BODY_ENABLED=false
# POOLPROX_LOG_BODY_FULL=false
# POOLPROX_LOG_BODY_MAX_BYTES=4096
# One-shot shrink of an already-huge DB:
#   bun scripts/prune-request-logs.ts

# Auth browser login (kiro/codebuddy/canva/qoder) uses Python Camoufox via
# scripts/auth/camoufox_flow.py. Default: auto-detect scripts/auth/.venv.
# Only set these if you intentionally override the shared auth venv.
# ETTEUM_PYTHON=                 # preferred override for camoufox_flow
# BATCHER_PYTHON=                # legacy alias for ETTEUM_PYTHON
# PYTHON_PATH=                   # used by canva_worker / login.py path
# AUTH_SCRIPT_PATH=./scripts/auth/login.py
# AUTH_SCRIPT_CWD=./scripts/auth

# Outbound proxy for the auth bot (optional, e.g. http://user:pass@host:port)
PROXY_URL=

# Browser engine for auth: camoufox (anti-detect, default) | chromium
BROWSER_ENGINE=camoufox
HEADLESS=true

# Captcha solver (optional)
CAPTCHA_SERVICE=none
CAPTCHA_API_KEY=

# 5sim.net API token for CodeBuddy CN phone farm (Automation → CodeBuddy CN)
# Also configurable from the dashboard modal (stored in settings).
# FIVE_SIM_TOKEN=

# Kiro Pro auto-upgrade (uses VCC pool)
KIRO_PRO_UPGRADE=false

# ── Built-in web_search server tool shim ──────────────────────────────────
# Anthropic's server-side web_search_* tool runs on Anthropic's servers, which
# this proxy's upstreams don't support. When WEB_SEARCH_ENABLED is on (default),
# the proxy shims it locally: converts the tool to a function call, runs the
# search via an open-source backend, and returns web_search_tool_result blocks.
#
# Default backend: DuckDuckGo Lite (keyless, no service — works on install).
# Optional backend: SearXNG (self-hosted, more robust). Set SEARXNG_URL to use it:
#   SEARXNG_URL=http://localhost:8080
# Searches per turn. Agent-driven: the model decides how many searches it needs
# and stops when it has enough; this is just a cost/abuse ceiling (default 50,
# hard cap 50). The per-turn overall timeout (2 min) is the other backstop.
# Set higher (e.g. 50) for deep research, or lower to bound spend.
#   WEB_SEARCH_MAX_USES=50
WEB_SEARCH_ENABLED=true
SEARXNG_URL=
WEB_SEARCH_MAX_USES=50
