# Core ports
PORT=1930
DASHBOARD_PORT=1931

# API key (clients send as Authorization: Bearer <key>)
API_KEY=pool-proxy-secret-key

# Database (SQLite)
DATABASE_PATH=./data/poolprox3.db

# Token encryption key (32 hex chars). install.sh / install.ps1 generate one for you.
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# Auth bot (Python + Playwright/Camoufox).
# Defaults below assume the in-tree venv at scripts/auth/.venv created by the installer.
AUTH_SCRIPT_PATH=./scripts/auth/login.py
# Python path — leave empty for auto-detection (recommended).
# The server auto-detects the correct venv path for your OS:
#   Linux/macOS: scripts/auth/.venv/bin/python
#   Windows:     scripts/auth/.venv/Scripts/python.exe
PYTHON_PATH=
AUTH_SCRIPT_CWD=./scripts/auth

# Outbound proxy for the auth bot (optional, e.g. http://user:pass@host:port)
PROXY_URL=

# Browser engine for auth: camoufox (anti-detect, default) | chromium
BROWSER_ENGINE=camoufox
HEADLESS=true

# Captcha solver (optional)
CAPTCHA_SERVICE=none
CAPTCHA_API_KEY=

# Kiro Pro auto-upgrade (uses VCC pool)
KIRO_PRO_UPGRADE=false

# ── Built-in web_search server tool shim ──────────────────────────────────
# Anthropic's server-side web_search_* tool runs on Anthropic's servers, which
# this proxy's upstreams don't support. When WEB_SEARCH_ENABLED is on (default),
# the proxy shims it locally: converts the tool to a function call, runs the
# search via an open-source backend, and returns web_search_tool_result blocks.
#
# Default backend: DuckDuckGo Lite (keyless, no service — works on install).
# Optional backend: SearXNG (self-hosted, more robust). Set SEARXNG_URL to use it:
#   SEARXNG_URL=http://localhost:8080
# Searches per turn. Agent-driven: the model decides how many searches it needs
# and stops when it has enough; this is just a cost/abuse ceiling (default 50,
# hard cap 50). The per-turn overall timeout (2 min) is the other backstop.
# Set higher (e.g. 50) for deep research, or lower to bound spend.
#   WEB_SEARCH_MAX_USES=50
WEB_SEARCH_ENABLED=true
SEARXNG_URL=
WEB_SEARCH_MAX_USES=50
