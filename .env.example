# Core ports
PORT=1930
DASHBOARD_PORT=1931

# ── Friend-key status page ("key console") ───────────────────────────────
# Standalone page showing one key's credit / usage / models. Create a key on the
# dashboard (API Key → New key), copy its share link, send the link to a friend.
# Port 80 often needs admin / conflicts locally — use a free port to test.
# SHARE_PORT=8090
# Public base URL of the status page (used to build the share links you copy).
# SHARE_PUBLIC_URL=http://127.0.0.1:8090
# The backend the page calls for key data (your /v1 API). Defaults to PORT.
# BACKEND_ORIGIN=http://127.0.0.1:1930
# The /v1 base URL shown to the friend (what they put in their app).
# SHARE_BASE_URL=http://127.0.0.1:1930/v1
# 1 = page only opens from a shared link (key in URL) and hides the paste box.
# SHARE_LOCK=0

# API key (clients send as Authorization: Bearer <key>)
API_KEY=pool-proxy-secret-key

# Database (SQLite)
DATABASE_PATH=./data/poolprox3.db

# Token encryption key (32 hex chars). install.sh / install.ps1 generate one for you.
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# ── Request log growth (scalability) ───────────────────────────────────────
# Detail rows in request_logs are capped; analytics use usage_summary (hourly).
# Bodies are OFF by default — full bodies were the multi-GB growth source.
# POOLPROX_MAX_REQUEST_LOGS=500
# POOLPROX_LOG_BODY_ENABLED=false
# POOLPROX_LOG_BODY_FULL=false
# POOLPROX_LOG_BODY_MAX_BYTES=4096
# One-shot shrink of an already-huge DB:
#   bun scripts/prune-request-logs.ts

# Auth automation is now TS+Camoufox (not Python scripts).
# The keys below are obsolete and kept as comments for reference.
# AUTH_SCRIPT_PATH=./scripts/auth/login.py
# PYTHON_PATH=
# AUTH_SCRIPT_CWD=./scripts/auth

# Outbound proxy for the auth bot (optional, e.g. http://user:pass@host:port)
PROXY_URL=

# Browser engine for auth: camoufox (anti-detect, default) | chromium
BROWSER_ENGINE=camoufox
HEADLESS=true

# Captcha solver (optional)
CAPTCHA_SERVICE=none
CAPTCHA_API_KEY=

# 5sim.net API token for CodeBuddy CN phone farm (Automation → CodeBuddy CN)
# Also configurable from the dashboard modal (stored in settings).
# FIVE_SIM_TOKEN=

# Kiro Pro auto-upgrade (uses VCC pool)
KIRO_PRO_UPGRADE=false

# ── Built-in web_search server tool shim ──────────────────────────────────
# Anthropic's server-side web_search_* tool runs on Anthropic's servers, which
# this proxy's upstreams don't support. When WEB_SEARCH_ENABLED is on (default),
# the proxy shims it locally: converts the tool to a function call, runs the
# search via an open-source backend, and returns web_search_tool_result blocks.
#
# Default backend: DuckDuckGo Lite (keyless, no service — works on install).
# Optional backend: SearXNG (self-hosted, more robust). Set SEARXNG_URL to use it:
#   SEARXNG_URL=http://localhost:8080
# Searches per turn. Agent-driven: the model decides how many searches it needs
# and stops when it has enough; this is just a cost/abuse ceiling (default 50,
# hard cap 50). The per-turn overall timeout (2 min) is the other backstop.
# Set higher (e.g. 50) for deep research, or lower to bound spend.
#   WEB_SEARCH_MAX_USES=50
WEB_SEARCH_ENABLED=true
SEARXNG_URL=
WEB_SEARCH_MAX_USES=50
